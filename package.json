{
    "name": "geo-invaders",
    "version": "0.5.1",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "NODE_ENV=development npx tsx scripts/generate-version.ts",
        "dev": "next dev --turbopack",
        "prebuild": "NODE_ENV=production npx tsx scripts/generate-version.ts",
        "build": "next build",
        "prebuild:local": "npx tsx scripts/generate-version.ts",
        "build:local": "next build",
        "start": "npx serve@latest out -s",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "version-packages": "npx @changesets/cli version",
        "release": "npm run build && npx @changesets/cli publish",
        "prepare": "husky",
        "commitlint": "commitlint --edit",
        "setup-labels": "npx tsx scripts/setup-labels.ts"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "lucide-react": "^1.14.0",
        "maplibre-gl": "^5.24.0",
        "next": "16.2.6",
        "next-themes": "^0.4.6",
        "react": "19.2.6",
        "react-dom": "19.2.6",
        "simple-icons": "^16.18.1",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^0.7.0",
        "@changesets/cli": "^2.31.0",
        "@commitlint/cli": "^21.0.1",
        "@commitlint/config-conventional": "^20.5.3",
        "@commitlint/prompt-cli": "^20.5.3",
        "@eslint/eslintrc": "^3",
        "@octokit/rest": "^22.0.1",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^25",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@typescript-eslint/eslint-plugin": "^8.47.0",
        "baseline-browser-mapping": "^2.10.27",
        "eslint": "^10.3.0",
        "eslint-config-next": "^16.2.6",
        "eslint-plugin-react": "^7.37.5",
        "husky": "^9.1.7",
        "octokit": "^5.0.5",
        "prettier": "^3.8.3",
        "tailwindcss": "^4",
        "tsx": "^4.21.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.5"
    }
}
