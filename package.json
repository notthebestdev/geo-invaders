{
    "name": "geo-invaders",
    "version": "0.5.0",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "NODE_ENV=development npx tsx scripts/generate-version.ts",
        "dev": "next dev --turbopack",
        "prebuild": "NODE_ENV=production npx tsx scripts/generate-version.ts",
        "build": "next build",
        "prebuild:local": "npx tsx scripts/generate-version.ts",
        "build:local": "next build",
        "start": "npx serve@latest out -s",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "version-packages": "npx @changesets/cli version",
        "release": "npm run build && npx @changesets/cli publish",
        "prepare": "husky",
        "commitlint": "commitlint --edit",
        "setup-labels": "npx tsx scripts/setup-labels.ts"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "lucide-react": "^1.7.0",
        "maplibre-gl": "^5.20.2",
        "next": "16.2.1",
        "next-themes": "^0.4.6",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "simple-icons": "^16.13.0",
        "tailwind-merge": "^3.5.0"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^0.5.2",
        "@changesets/cli": "^2.30.0",
        "@commitlint/cli": "^20.5.0",
        "@commitlint/config-conventional": "^20.5.0",
        "@commitlint/prompt-cli": "^20.5.0",
        "@eslint/eslintrc": "^3",
        "@octokit/rest": "^22.0.1",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^25",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@typescript-eslint/eslint-plugin": "^8.47.0",
        "baseline-browser-mapping": "^2.10.11",
        "eslint": "^9.39.4",
        "eslint-config-next": "^16.2.1",
        "eslint-plugin-react": "^7.37.5",
        "husky": "^9.1.7",
        "octokit": "^5.0.5",
        "prettier": "^3.8.1",
        "tailwindcss": "^4",
        "tsx": "^4.21.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.2"
    }
}
