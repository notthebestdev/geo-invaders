{
    "name": "geo-invaders",
    "version": "0.4.0",
    "private": true,
    "type": "commonjs",
    "scripts": {
        "predev": "NODE_ENV=development node scripts/generate-version.ts",
        "dev": "next dev --turbopack",
        "prebuild": "NODE_ENV=production node scripts/generate-version.ts",
        "build": "next build",
        "start": "npx serve@latest out",
        "lint": "eslint .",
        "format": "prettier --write .",
        "version-packages": "npx @changesets/cli version",
        "release": "npm run build && npx @changesets/cli publish",
        "prepare": "husky",
        "commitlint": "commitlint --edit",
        "setup-labels": "npx tsx scripts/setup-labels.ts"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "lucide-react": "^0.577.0",
        "maplibre-gl": "^5.19.0",
        "next": "16.1.6",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "simple-icons": "^16.11.0",
        "tailwind-merge": "^3.5.0"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^0.5.2",
        "@changesets/cli": "^2.30.0",
        "@commitlint/cli": "^20.4.3",
        "@commitlint/config-conventional": "^20.4.2",
        "@commitlint/prompt-cli": "^20.4.4",
        "@eslint/eslintrc": "^3",
        "@octokit/rest": "^22.0.1",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^25",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@typescript-eslint/eslint-plugin": "^8.47.0",
        "baseline-browser-mapping": "^2.10.7",
        "eslint": "^10.0.2",
        "eslint-config-next": "^16.1.6",
        "eslint-plugin-react": "^7.37.5",
        "husky": "^9.1.7",
        "prettier": "^3.8.1",
        "tailwindcss": "^4",
        "tsx": "^4.21.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5"
    }
}
